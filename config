# Font settings
font-family = Maple Mono NF
font-style = Regular
font-feature = +calt
font-size = 10
# Fit whole rows into the current 1080px display height.
adjust-cell-height = -12%

# Cursor
cursor-style = block
cursor-style-blink = false

# Terminal
term = xterm-ghostty

# Scrollback (50000 lines)
scrollback-limit = 100000000

# Selection - disable auto copy, use Ctrl+Shift+C to copy
copy-on-select = false
keybind = ctrl+shift+c=copy_to_clipboard

# Window settings
window-decoration = false
background-opacity = 0.90
background-blur = true
# fullscreen = false  (disabled to show transparency - maximize window instead)
maximize = true
window-padding-color = extend
mouse-hide-while-typing = true
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

# Auto reload config
auto-update = check

# GTK Tab Styling (minimal like tmux/zellij)
gtk-wide-tabs = false
gtk-toolbar-style = flat
gtk-titlebar-style = native
gtk-titlebar-hide-when-maximized = true
gtk-tabs-location = bottom
gtk-single-instance = true

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 30s

# New Windows, Tabs, Splits whether should inherit the active dir in current terminal
window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Theme - custom
theme = /home/snehilshah/.config/ghostty/themes/colorterm

# Background image (uncomment to enable)
background-image = /home/snehilshah/Walls/pixel/unicorn-flip.png
background-image-opacity = 0.1

# free Alt+1-9 for zellij tab switching
keybind = alt+1=unbind
keybind = alt+digit_1=unbind
keybind = alt+2=unbind
keybind = alt+digit_2=unbind
keybind = alt+3=unbind
keybind = alt+digit_3=unbind
keybind = alt+4=unbind
keybind = alt+digit_4=unbind
keybind = alt+5=unbind
keybind = alt+digit_5=unbind
keybind = alt+6=unbind
keybind = alt+digit_6=unbind
keybind = alt+7=unbind
keybind = alt+digit_7=unbind
keybind = alt+8=unbind
keybind = alt+digit_8=unbind
keybind = alt+9=unbind
keybind = alt+digit_9=unbind
